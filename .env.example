# ── N-ATLaS Mobile SDK — environment variables ─────────────────────────────
# Copy to .env and fill in values. Never commit .env.

# Gateway base URL (your self-hosted Modal or Docker endpoint)
NATLAS_BASE_URL=https://your-modal-endpoint.modal.run

# Bearer token for the gateway
NATLAS_API_KEY=your_api_key_here

# Hugging Face token (needed by serve/ to download gated model weights)
HF_TOKEN=hf_your_token_here

# Modal secret name (used by serve/modal_app.py)
MODAL_SECRET_NAME=natlas-api
